# i3 — tiling WM for the Legion (X11). Symlinked to ~/.config/i3/config by
# bootstrap-desktop.sh.
#
# Based on i3's upstream default config (i3/etc/config), with deliberate
# deviations noted inline. Read the DEVIATIONS block before "fixing" anything.
#
# ── DEVIATIONS FROM UPSTREAM DEFAULT ──────────────────────────────────
#  1. $mod is Mod4 (Super), not Mod1 (Alt). Upstream picks Alt, but Alt belongs
#     to nvim — binding it here eats nvim's Alt maps whenever a terminal has
#     focus, which is always on this machine.
#  2. Direction keys are h/j/k/l, not upstream's j/k/l/semicolon. Matches tmux
#     (C-hjkl pane nav) and nvim, so one set of muscle memory covers all three.
#  3. rofi instead of dmenu — same job, and it also gives window switching
#     ($mod+Tab), which dmenu can't do.
#  4. Splits are also bound to $mod+bar / $mod+backslash to mirror tmux's
#     prefix-| and prefix--. Upstream's $mod+b / $mod+v are kept as well, so
#     $mod+minus stays free for scratchpad (upstream's binding).
#  5. No compositor (picom). Costs battery on a hybrid-GPU laptop for
#     transparency we don't use. Cost: video can tear. Add picom if that bites.
#
# GNOME stays installed — this is a login-screen alternative, not a
# replacement. Everything GNOME used to do for us (brightness, locking,
# notifications, network/Bluetooth UI, polkit prompts, power-profile switching)
# is wired up explicitly below, because i3 does none of it.

set $mod Mod4

# Direction keys, defined once (upstream does this too, so rebinding is one edit)
set $left  h
set $down  j
set $up    k
set $right l

# Terminal is resolved by a wrapper rather than hardcoded: Ghostty on this box,
# but the same config must work on a machine where it isn't installed yet.
set $term ~/.config/i3/scripts/terminal
set $lock i3lock -n -c 161616

# Upstream default font. Pango, so it handles the bar's glyphs.
font pango:JetBrains Mono 11

# ── Startup ────────────────────────────────────────────────────────────
# --no-startup-id on everything: without it i3 shows a "loading" cursor forever
# for programs that never send a startup-notification completion.
#
# Each of these is guarded with `command -v` so this config stays portable to a
# box where the package isn't installed — a missing binary must not leave you
# with a half-started session you can't fix.

# XDG autostart (upstream default). Starts ~/.config/autostart entries —
# keyring, portals, anything a GUI app dropped there.
exec --no-startup-id sh -c 'command -v dex >/dev/null && dex --autostart --environment i3'

# Screen locking, tied to both the X idle timer and systemd's lock signal, so
# `loginctl lock-session` and lid-close both reach i3lock. (Upstream default.)
exec --no-startup-id sh -c 'command -v xss-lock >/dev/null && xss-lock --transfer-sleep-lock -- $lock'

# NetworkManager tray applet (upstream default). This machine is WiFi-only and
# i3 has no network UI whatsoever — without this there is no graphical way to
# join a network. `nmtui` in a terminal is the fallback.
exec --no-startup-id sh -c 'command -v nm-applet >/dev/null && nm-applet'

# Bluetooth tray. Not upstream, but this box pairs a mouse, keyboard and
# SpaceMouse over BT; `bluetoothctl` is a poor substitute for reconnecting them.
exec --no-startup-id sh -c 'command -v blueman-applet >/dev/null && blueman-applet'

# Polkit authentication agent. Without one, any GUI action needing elevation
# (mounting a disk, a GNOME settings panel, an updater) fails silently with no
# password prompt at all. GNOME provides this implicitly; i3 does not.
exec --no-startup-id sh -c 'for p in /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/bin/lxpolkit; do [ -x "$p" ] && exec "$p"; done'

# Notifications. i3 has none; dunst is the standard answer.
exec --no-startup-id sh -c 'command -v dunst >/dev/null && dunst'

# Xresources — Xft.dpi, which is how X11 apps get scaled. 110 rather than the
# default 96 for a touch over 1.15x, which this 2560x1600 16" panel needs to be
# comfortable. GNOME handled this with text-scaling-factor; i3 does not.
exec_always --no-startup-id xrdb -merge ~/.Xresources

# Pointer settings GNOME's settings daemon used to apply. Without this,
# scrolling reverses and tap-to-click stops working the first time you use i3.
exec_always --no-startup-id ~/.config/i3/scripts/input-setup

# Match the panel refresh rate to the power source, and keep matching it.
exec_always --no-startup-id ~/.config/i3/scripts/refresh-rate-daemon

# Lyrebird's dictation daemon, holding the Whisper model in memory so F9 is
# instant. `exec` not `exec_always`: reloading i3 should not restart it and throw
# away a model that took seconds to load.
exec --no-startup-id sh -c '[ -x "$HOME/lyrebird/.venv/bin/python" ] && cd "$HOME/lyrebird" && exec ./.venv/bin/python src/dictate.py --daemon'

# ── Look — carbonfox, matching tmux/nvim ───────────────────────────────
set $bg      #161616
set $fg      #f2f4f8
set $accent  #78a9ff
set $dim     #6b6b6b
set $urgent  #ee5396
set $panel   #2a2a2a

#                       border   background  text   indicator  child_border
client.focused          $accent  $accent     $bg    $accent    $accent
client.focused_inactive $panel   $panel      $fg    $panel     $panel
client.unfocused        $bg      $bg         $dim   $bg        $panel
client.urgent           $urgent  $urgent     $bg    $urgent    $urgent

# i3 4.22+ has gaps built in (no i3-gaps fork needed). Modest, not decorative.
gaps inner 6
gaps outer 0
smart_gaps on
smart_borders on
default_border pixel 2
default_floating_border pixel 2

# ── Window management ──────────────────────────────────────────────────
floating_modifier $mod
tiling_drag modifier titlebar

bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Tab exec --no-startup-id rofi -show window

# Focus
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# Move
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

# Splits — upstream's b/v, plus tmux-style bar/backslash aliases
bindsym $mod+b         split h
bindsym $mod+v         split v
bindsym $mod+bar       split h
bindsym $mod+backslash split v

bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad (upstream default) — stash a window, summon it anywhere. Good for
# a notes buffer or a long-running log you want to glance at.
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# ── Workspaces ─────────────────────────────────────────────────────────
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Cycle workspaces, echoing tmux's prefix C-n / C-p for windows
bindsym $mod+Ctrl+$right workspace next
bindsym $mod+Ctrl+$left  workspace prev
bindsym $mod+grave workspace back_and_forth

# ── Resize ─────────────────────────────────────────────────────────────
mode "resize" {
    bindsym $left  resize shrink width 5 px or 5 ppt
    bindsym $down  resize grow height 5 px or 5 ppt
    bindsym $up    resize shrink height 5 px or 5 ppt
    bindsym $right resize grow width 5 px or 5 ppt
    bindsym Left   resize shrink width 5 px or 5 ppt
    bindsym Down   resize grow height 5 px or 5 ppt
    bindsym Up     resize shrink height 5 px or 5 ppt
    bindsym Right  resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ── Floating rules ─────────────────────────────────────────────────────
# Dialogs and transient windows tile badly. These are the common offenders.
for_window [window_role="pop-up"]      floating enable
for_window [window_role="bubble"]      floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"]      floating enable
for_window [window_type="menu"]        floating enable
for_window [window_type="utility"]     floating enable
for_window [window_type="toolbar"]     floating enable
for_window [window_type="notification"] floating enable
for_window [window_type="splash"]      floating enable
for_window [class="Pavucontrol"]       floating enable
for_window [class="Blueman-manager"]   floating enable
for_window [class="Nm-connection-editor"] floating enable
# Small always-on-top utilities. Tiling these just shoves your real windows
# around for something you glance at and dismiss.
for_window [class="gnome-calculator"]  floating enable
for_window [class="Gnome-calculator"]  floating enable
# Opened by clicking a bar block — glance-and-dismiss, so they float too.
for_window [class="Gnome-system-monitor"] floating enable
for_window [class="Baobab"]            floating enable
for_window [class="Gnome-calendar"]    floating enable
for_window [class="Gnome-power-statistics"] floating enable

# ── Hardware keys (GNOME used to handle these) ─────────────────────────
# brightnessctl needs no root: the package ships a udev rule granting the
# 'video' group write access to the backlight.
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Volume, via a script that also shows an on-screen notification — GNOME had an
# OSD for this and i3 has none, so without it a volume change is invisible.
#
# NB these are the MEDIA keysyms, which on this Legion's function-first F-row
# means holding Fn (Fn+F1/F2/F3). Fn+Esc toggles Fn-lock if you would rather have
# the media keys be primary.
bindsym XF86AudioRaiseVolume  exec --no-startup-id ~/.config/i3/scripts/volume up
bindsym XF86AudioLowerVolume  exec --no-startup-id ~/.config/i3/scripts/volume down
bindsym XF86AudioMute         exec --no-startup-id ~/.config/i3/scripts/volume mute
bindsym XF86AudioMicMute      exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Fn+Q on this Legion cycles the ACPI platform profile. Some firmware revisions
# emit XF86Launch1 for it; harmless if it never fires. $mod+p is the reliable
# way to do the same thing.
bindsym XF86Launch1 exec --no-startup-id ~/.config/i3/scripts/cycle-power-profile
bindsym $mod+p      exec --no-startup-id ~/.config/i3/scripts/cycle-power-profile

# Screenshots — flameshot, on the Print key (next to Delete).
#   Print              drag a region with the annotation toolbar — the common
#                      case, so it gets the bare key
#   Shift+Print        whole screen straight to the clipboard, no prompting
#   Ctrl+Shift+Print   whole screen, with a Save dialog
#
# Inside the region UI (set in flameshot.ini's [Shortcuts]):
#   Return             copy to clipboard
#   Shift+Return       save, with the file dialog
#   Ctrl+Return        accept (moved off Return so it does not collide)
#
# saveAfterCopy=true means the clipboard paths also drop a file in
# ~/Pictures/Screenshots, so nothing is lost if you paste over the clipboard.
#
# Under GNOME this key is grabbed by GNOME's own screenshot UI (which is why it
# never shows up in xev there). i3 sets no such grab, so it reaches these.
#
# NB not bound to Super+Shift+4/5 to mirror macOS: those are already "move
# container to workspace 4/5", which is core i3 and worth more than the muscle
# memory.
#
# Save location, and remembering the last folder you picked, live in
# ~/.config/flameshot/flameshot.ini — flameshot rewrites that file itself, so it
# is deliberately not tracked in this repo.
#
# Two landmines in that file, found the hard way. flameshot 12.1 REFUSES TO RUN
# if it sees a key it does not accept — it exits without capturing and prints
# nothing but an unrelated Qt session-management warning:
#     showSidePanel=true        breaks it
#     saveAfterCopyPath=...     breaks it   (saveAfterCopy=true alone is fine,
#                                            and saves into savePath)
# It also exits 1 even when the capture succeeded, so never test it by exit code
# — check for the file or the clipboard instead.
#
# Working set of keys: savePath, savePathFixed, saveAfterCopy, filenamePattern,
# showHelp, showDesktopNotification, showMagnifier, disabledTrayIcon, uiColor,
# contrastUiColor, drawColor.
# bindcode, not bindsym, and this is the whole reason: the Print key's shifted
# level is a different keysym.
#
#   keycode 107 = Print  Sys_Req  Print  Sys_Req
#
# So Shift+Print produces Sys_Req, `bindsym Shift+Print` never matches, and the
# plain Print binding fires instead — you press Shift+Print and get a silent
# full-screen grab rather than the region selector. bindcode matches the physical
# key and ignores keysym levels entirely.
#
# Both 107 and 218 are bound because this machine's keymap defines Print on both
# (two internal ITE keyboards). Only one is physically present, so nothing
# double-fires.
bindcode 107            exec --no-startup-id flameshot gui
bindcode Shift+107      exec --no-startup-id flameshot full -c
bindcode Ctrl+Shift+107 exec --no-startup-id flameshot full
bindcode 218            exec --no-startup-id flameshot gui
bindcode Shift+218      exec --no-startup-id flameshot full -c
bindcode Ctrl+Shift+218 exec --no-startup-id flameshot full

# Calculator. gnome-calculator ships with Ubuntu and does unit/base conversion,
# which is most of what this key ever gets used for.
bindsym F12 exec --no-startup-id gnome-calculator
bindsym XF86Calculator exec --no-startup-id gnome-calculator

# Lyrebird — offline dictation (~/lyrebird). F9 toggles recording.
#
# Two processes on purpose. Loading large-v3-turbo takes seconds, so the model
# cannot be loaded per keypress: the daemon stays resident holding it, and F9
# runs a one-shot --toggle that signals the daemon and exits immediately.
#
# i3 owns the keybinding rather than Lyrebird grabbing a global hotkey with
# pynput. That is the standard split, avoids two things fighting over one key,
# and is the only arrangement that would survive a move to Wayland — where
# pynput's X11 grab does not work at all.
bindsym F9 exec --no-startup-id sh -c 'cd "$HOME/lyrebird" && ./.venv/bin/python src/dictate.py --toggle'

# ── Session ────────────────────────────────────────────────────────────
# Help. i3 has no built-in help key, and Debian strips its HTML docs, so this
# opens the upstream reference card — which is the cheat sheet, rather than a
# hand-maintained list here that would drift from the actual bindings.
# Read it with two substitutions: Super for the modifier, hjkl for jkl;.
# Offline: `man i3`.
bindsym $mod+Shift+slash exec --no-startup-id xdg-open https://i3wm.org/docs/refcard.html

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Ctrl+q exec --no-startup-id $lock
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning \
    -m 'Exit i3?' -B 'Exit' 'i3-msg exit'

# ── Bar ────────────────────────────────────────────────────────────────
bar {
    # Wrapped rather than calling i3status directly: i3status has no "run this
    # command" module, so scripts/status splices a GPU block into its JSON,
    # colour-codes load, and compacts the units.
    status_command ~/.config/i3/scripts/status ~/.config/i3/i3status.conf
    position top
    # Smaller than i3's own 11pt font: the bar holds a lot of readings and this
    # is the cheapest way to fit more without shortening them further.
    font pango:JetBrains Mono 9
    tray_output primary
    separator_symbol " | "
    colors {
        background $bg
        statusline $fg
        separator  $panel
        #                  border   background  text
        focused_workspace  $accent  $accent     $bg
        active_workspace   $panel   $panel      $fg
        inactive_workspace $bg      $bg         $dim
        urgent_workspace   $urgent  $urgent     $bg
    }
}
