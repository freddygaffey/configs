#!/usr/bin/env sh
# Switch the whole desktop between three looks.
#
#   ui-mode dark     everything dark
#   ui-mode light    light apps, and a BLUE terminal — neither the near-black of
#                    dark mode nor the off-white of fly. A deliberate third
#                    state, so light mode does not read as dark mode with the
#                    browser wrong
#   ui-mode fly      everything light, terminal and editor included — for
#                    working outdoors in glare
#   ui-mode cycle    dark -> light -> fly -> dark
#   ui-mode status   print the current mode
#
# "light" is the awkward one and the reason this exists: GTK apps and the
# terminal have to disagree, so "follow the system colour scheme" cannot express
# it and each surface is set explicitly.
#
# ── How colours are defined ────────────────────────────────────────────
# Each palette is written down EXACTLY ONCE, in themes/<name>.env. Every app's
# config is rendered from it through templates/*.template, so a hex value never
# appears in two places and the apps cannot drift apart.
#
#   themes/carbonfox.env     the dark palette
#   themes/dayfox.env        the light palette
#   templates/*.template     one per app, using @key@ placeholders
#
# Adding a theme is one new themes/*.env file. Adding an app is one new
# template plus a line in render_all().
#
# nvim is the exception: it loads a colorscheme by name rather than being handed
# colours, so the palette's name= field is passed through instead.
#
# ── What updates live ──────────────────────────────────────────────────
#   GTK      gsettings, picked up by running apps immediately
#   browsers via the XDG portal's org.freedesktop.appearance (see the portals
#            note in the README) — Firefox, Chrome and Electron follow it
#   kitty    `kitty @ set-colors` repaints open windows
#   nvim     :colorscheme pushed to every running instance over its RPC socket
#   bar      i3status poked with SIGUSR1 so the mode indicator updates at once
#   tmux     theme sourced into every running server
#   dunst    killed; D-Bus activation restarts it on the next notification
#   claude   settings.json theme merged with jq — NEW sessions only, a running
#            Claude Code keeps the theme it started with
#   desktop  root window filled with the palette's bg, or an image if the
#            palette names a wallpaper
#   i3       `i3-msg restart`, which re-reads the config and keeps your layout

set -eu

REPO="${UI_MODE_REPO:-$HOME/.dotfiles/configs}"
MODE_FILE="$HOME/.config/ui-mode"
THEME_FILE="$HOME/.config/ui-theme"          # read by nvim at startup

usage() { echo "usage: ui-mode dark|light|fly|cycle|status" >&2; exit 1; }
current() { [ -r "$MODE_FILE" ] && cat "$MODE_FILE" || echo dark; }

# mode -> gtk_theme  colour_scheme  palette
#
# Each mode has its own palette. light is not dark-with-light-GTK: it gets
# nightfox, a blue-tinted dark that sits next to white app windows better than
# pure black does.
settings_for() {
    case "$1" in
        dark)  echo "Yaru-dark prefer-dark  carbonfox" ;;
        light) echo "Yaru      prefer-light nightfox"  ;;
        fly)   echo "Yaru      prefer-light dayfox"    ;;
        *)     usage ;;
    esac
}

# render <template> <palette> <destination>
#
# Substitutes @key@ for each KEY=VALUE in the palette. Built as a single sed
# script rather than one pass per key, so the file is read and written once.
#
# Returns 1 if the destination was already identical. Callers use that to skip
# work that is only needed when something actually changed — see apply_i3.
render() {
    template="$1"; palette="$2"; dest="$3"
    [ -r "$template" ] && [ -r "$palette" ] || return 1

    script=$(
        while IFS='=' read -r key value; do
            case "$key" in ''|\#*) continue ;; esac
            printf 's|@%s@|%s|g\n' "$key" "$value"
        done < "$palette"
    )

    mkdir -p "$(dirname "$dest")"
    tmp="$dest.tmp.$$"
    sed "$script" "$template" > "$tmp"

    if [ -r "$dest" ] && cmp -s "$tmp" "$dest"; then
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$dest"
    return 0
}

palette_value() {   # palette_value <palette> <key>
    sed -n "s/^$2=//p" "$1" | head -1
}

apply_gtk() {
    command -v gsettings >/dev/null 2>&1 || return 0
    gsettings set org.gnome.desktop.interface gtk-theme "$1" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme "$2" 2>/dev/null || true
}

apply_kitty() {
    command -v kitty >/dev/null 2>&1 || return 0
    # NB not named "theme": sh has no local variables, so that would clobber the
    # caller's $theme — which it did, and the status line printed a path.
    kitty_theme="$HOME/.config/kitty/theme.conf"
    [ -r "$kitty_theme" ] || return 0

    # Repaint open windows. kitty appends its pid to the socket name from
    # `listen_on`, so the configured "@mykitty" never exists as such — the real
    # sockets are @mykitty-1234, and have to be found in /proc/net/unix.
    awk '{print $NF}' /proc/net/unix 2>/dev/null \
      | grep '^@mykitty' | sort -u \
      | while read -r sock; do
            kitty @ --to "unix:$sock" set-colors --all "$kitty_theme" >/dev/null 2>&1 || true
            # Opacity is not a colour, so set-colors does not carry it — and it
            # cannot be changed by re-reading the config either. This is the only
            # way to move it on a running window.
            [ -n "${1:-}" ] && kitty @ --to "unix:$sock" \
                set-background-opacity "$1" >/dev/null 2>&1 || true
        done
}

apply_nvim() {
    printf '%s\n' "$1" > "$THEME_FILE"
    command -v nvim >/dev/null 2>&1 || return 0

    # Push to anything already open. nvim always listens on a socket under
    # XDG_RUNTIME_DIR, so no --listen flag is needed.
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    for sock in "$runtime"/nvim.*; do
        [ -S "$sock" ] || continue
        nvim --server "$sock" --remote-expr \
             "execute('silent! colorscheme $1')" >/dev/null 2>&1 || true
    done
}

apply_background() {
    # Delegated: i3/scripts/wallpaper owns image selection, including the
    # per-mode directory and the flat-colour fallback when there are no images.
    # "reapply" keeps the current image if it belongs to the new mode's
    # directory, and moves to one that does if it does not.
    script="$HOME/.config/i3/scripts/wallpaper"
    [ -x "$script" ] && "$script" reapply >/dev/null 2>&1 || true
}


apply_tmux() {
    # Live-apply to every running server. tmux.conf sources this file at startup,
    # which covers new servers; this covers the one you are sitting in.
    theme_file="$HOME/.config/tmux/theme.conf"
    [ -r "$theme_file" ] || return 0
    command -v tmux >/dev/null 2>&1 || return 0
    tmux list-sessions >/dev/null 2>&1 || return 0
    tmux source-file "$theme_file" >/dev/null 2>&1 || true
}


apply_dunst() {
    # dunst 1.9 has no reload command, but it is D-Bus activated: killing it
    # means the next notification starts a fresh one with the new config.
    pkill -x dunst >/dev/null 2>&1 || true
}

refresh_bar() {
    # i3status refreshes on its own interval (5s), so the bar's mode indicator
    # lagged up to five seconds behind the switch — which read as the bar being
    # slow to change, even though its colours are identical across modes and
    # never change at all.
    #
    # SIGUSR1 makes i3status emit a line immediately. -x so this cannot match
    # the wrapper script or anything else with i3status in its command line.
    pkill -USR1 -x i3status >/dev/null 2>&1 || true
}


apply_i3() {
    # restart, not reload: colours are only read at config parse time. restart
    # re-reads the config and keeps the layout and windows exactly as they are —
    # but it visibly tears down and rebuilds, flashing the root window and other
    # workspaces on the way past.
    #
    # So only do it when i3's colours actually changed. dark and light share the
    # same palette (only GTK differs between them), so that switch needs no
    # restart at all and is instant. Only a switch into or out of fly pays it.
    command -v i3-msg >/dev/null 2>&1 && i3-msg restart >/dev/null 2>&1 || true
}

# NB takes the palette PATH, not the theme name. This runs inside a command
# substitution to return the nvim theme name, so it is a subshell — anything it
# assigns is lost. The caller computes the path and passes it in.
# Sets I3_CHANGED=1 if i3's colours differ from what is already in place.
# Claude Code. Not rendered from a template like the other apps, for two
# reasons: it takes a NAMED theme rather than hex colours, and its settings.json
# holds unrelated settings (model, plugins, permissions) that a rendered file
# would destroy. So the one key is merged in with jq.
#
# It follows the terminal's palette rather than the desktop's, because that is
# where it runs. Its own "auto" setting follows the system colour scheme, which
# in light mode means light — inside a deliberately dark terminal. Exactly wrong.
#
# Only new sessions pick this up; a running Claude Code keeps the theme it
# started with.
render_claude() {
    palette="$1"
    want=$(palette_value "$palette" claude_theme)
    [ -n "$want" ] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    settings="$HOME/.claude/settings.json"
    [ -r "$settings" ] || return 0
    # Skip the write when it already matches, so a mode switch does not churn
    # the file (and its mtime) for nothing.
    [ "$(jq -r '.theme // empty' "$settings" 2>/dev/null)" = "$want" ] && return 0
    # Temp file in the SAME directory, so the mv is atomic — across filesystems
    # it degrades to copy+unlink, which can truncate settings.json on a crash.
    tmp=$(mktemp "$settings.XXXXXX") || return 0
    if jq --arg t "$want" '.theme = $t' "$settings" > "$tmp" 2>/dev/null \
       && [ -s "$tmp" ]; then
        mv "$tmp" "$settings"
    else
        rm -f "$tmp"
    fi
}

render_all() {
    palette="$1"
    i3_changed=0

    # Optional per-surface overrides. A palette may set term_bg/term_fg to give
    # the TERMINAL a different shade from the rest of the desktop — useful when a
    # light theme is right for apps but its background is too bright to stare
    # into all day. Unset, they fall back to bg/fg, so a palette that does not
    # care stays a plain list of colours.
    #
    # Written to a temp copy rather than the palette itself, so the defaults are
    # never persisted into a file you edit by hand.
    resolved="${XDG_RUNTIME_DIR:-/tmp}/ui-palette.$$"
    cp "$palette" "$resolved"
    grep -q '^term_bg=' "$palette" || printf 'term_bg=%s\n' "$(palette_value "$palette" bg)" >> "$resolved"
    grep -q '^term_fg=' "$palette" || printf 'term_fg=%s\n' "$(palette_value "$palette" fg)" >> "$resolved"
    grep -q '^term_opacity=' "$palette" || printf 'term_opacity=1.0\n' >> "$resolved"
    palette="$resolved"
    render "$REPO/templates/i3-colours.template"  "$palette" "$HOME/.config/i3/colours.conf" \
        && i3_changed=1
    render "$REPO/templates/kitty-theme.template" "$palette" "$HOME/.config/kitty/theme.conf" || true
    render "$REPO/templates/dunstrc.template"     "$palette" "$HOME/.config/dunst/dunstrc" || true
    render "$REPO/templates/tmux-theme.template"  "$palette" "$HOME/.config/tmux/theme.conf" || true
    render "$REPO/templates/rofi-theme.template"  "$palette" "$HOME/.config/rofi/theme.rasi" || true
    render_claude "$palette" || true
    # Both values on one line: this runs in a command substitution, so the
    # caller reads them back rather than seeing any variable we set.
    printf '%s %s\n' "$(palette_value "$palette" name)" "$i3_changed"
    rm -f "$resolved"
}

mode="${1:-}"
[ -n "$mode" ] || usage

case "$mode" in
    status) current; exit 0 ;;
    cycle)
        case "$(current)" in
            dark)  mode=light ;;
            light) mode=fly   ;;
            *)     mode=dark  ;;
        esac
        ;;
esac

set -- $(settings_for "$mode")
gtk_theme="$1"; colour_scheme="$2"; theme="$3"

palette="$REPO/themes/$theme.env"
[ -r "$palette" ] || { echo "no such theme: $theme" >&2; exit 1; }

render_out=$(render_all "$palette")
nvim_theme=${render_out% *}
i3_changed=${render_out##* }
apply_gtk "$gtk_theme" "$colour_scheme"
apply_kitty "$(sed -n "s/^term_opacity=//p" "$palette" | head -1)"
apply_nvim "${nvim_theme:-$theme}"
apply_background
apply_tmux
apply_dunst

# Written before the i3 restart: the restart replaces this process's parent, so
# anything after it may not run.
printf '%s\n' "$mode" > "$MODE_FILE"
refresh_bar

if [ "$i3_changed" = "1" ]; then
    echo "ui-mode: $mode ($theme) — restarting i3 for its colours"
    apply_i3
else
    echo "ui-mode: $mode ($theme)"
fi
