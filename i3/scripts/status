#!/usr/bin/env python3
"""i3bar status_command: i3status, with the bits i3status cannot do itself.

i3status modules only support fixed thresholds and fixed format strings, so
anything conditional has to happen out here. This wrapper:

  - inserts a GPU block just after the platform profile
  - colour-codes load against this machine's 24 threads
  - shortens the profile name ("power-saver" is wide for what it tells you)
  - drops the battery wattage when nothing is actually flowing

The i3bar protocol i3status speaks:

    {"version":1}            header, once
    [                        opening bracket of an infinite array, once
    [{...},{...}]            one line per refresh
    ,[{...},{...}]           every line after the first, comma-prefixed

Requires output_format = "i3bar" in i3status.conf — i3status auto-detects and
falls back to plain text when it is not talking straight to i3bar.
"""

import json
import os
import re
import subprocess
import sys
import threading

CONF = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser(
    "~/.config/i3/i3status.conf")
GPU = os.path.expanduser("~/.config/i3/scripts/gpu-status")

# carbonfox, matching the rest of the bar
GOOD = "#25be6a"
WARN = "#f1c21b"
BAD = "#ee5396"
DIM = "#6b6b6b"
ACCENT = "#78a9ff"

# 24 threads (8 P + 16 E), so a load of 4 is idle-ish and 8 is unremarkable.
# A single max_threshold cannot express that, which is why load is coloured here.
LOAD_WARN = 8.0
LOAD_BAD = 18.0

# "performance" and "power-saver" are wide for one word of information.
PROFILE_SHORT = {
    "performance": "perf",
    "balanced": "bal",
    "power-saver": "save",
    "low-power": "save",
    "quiet": "quiet",
}


UI_MODE_FILE = os.path.expanduser("~/.config/ui-mode")

# dark / light / fly, each with a glyph that reads at a glance without the word.
MODE_GLYPH = {"dark": "\u25cf", "light": "\u25d0", "fly": "\u25cb"}


def ui_mode_block():
    """Which UI mode is active. Written by i3/scripts/ui-mode."""
    try:
        with open(UI_MODE_FILE) as handle:
            mode = handle.read().strip()
    except OSError:
        return None
    if not mode:
        return None
    return {"name": "uimode",
            "full_text": f"{MODE_GLYPH.get(mode, '?')} {mode}",
            "color": DIM if mode == "dark" else ACCENT}


def helper_block(path, name):
    """Run a helper script and wrap its one line of output as a block."""
    try:
        text = subprocess.run([path], capture_output=True, text=True,
                              timeout=4).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return {"name": name, "full_text": text} if text else None


def gpu_block():
    return helper_block(GPU, "gpu")


def colour_load(block):
    """Colour the load block by how loaded the machine actually is."""
    match = re.search(r"([\d.]+)", block.get("full_text", ""))
    if not match:
        return
    value = float(match.group(1))
    if value >= LOAD_BAD:
        block["color"] = BAD
    elif value >= LOAD_WARN:
        block["color"] = WARN
    else:
        block["color"] = GOOD


# Colour carries the meaning here: green is cheap, amber costs battery. Saves
# reading the word at all once you know the colours.
PROFILE_COLOUR = {
    "performance": WARN,
    "balanced": ACCENT,
    "power-saver": GOOD,
    "low-power": GOOD,
}


def shorten_profile(block):
    text = block.get("full_text", "").strip()
    block["full_text"] = "\u26a1 " + PROFILE_SHORT.get(text, text)
    colour = PROFILE_COLOUR.get(text)
    if colour:
        block["color"] = colour


def colour_gpu(block):
    """Dim when the card is asleep, graded by utilisation when it is not.

    Asleep is the normal, desirable state on battery, so it should not read as
    an alarm — but it should be visually distinct from 0% while awake."""
    text = block.get("full_text", "")
    if "zZ" in text:
        block["color"] = DIM
        return
    match = re.search(r"(\d+)%", text)
    if not match:
        block["color"] = DIM
        return
    util = int(match.group(1))
    block["color"] = BAD if util >= 80 else WARN if util >= 40 else GOOD


def colour_volume(block):
    # format_muted is "vol ---", so muted is visible by shape as well as colour.
    if "---" in block.get("full_text", ""):
        block["color"] = DIM


def compact_sizes(block):
    """'9 GiB/31 GiB' -> '9/31G'. i3status can pick the unit but always spells
    it out, and three of these blocks sit side by side."""
    text = block.get("full_text", "")
    text = re.sub(r"\s*GiB", "G", text)
    text = re.sub(r"\s*MiB", "M", text)
    text = re.sub(r"\s*TiB", "T", text)
    # '9G/31G' -> '9/31G': the unit on both halves is noise.
    text = re.sub(r"(\d)G/(\d+)G", r"\1/\2G", text)
    block["full_text"] = text


def transform(blocks):
    for block in blocks:
        name = block.get("name")
        if name == "load":
            colour_load(block)
        elif name == "read_file":
            # NB read_file's `instance` is the file path, not the module name,
            # so match on the name alone — there is only one such module.
            shorten_profile(block)
        elif name in ("memory", "disk_info"):
            compact_sizes(block)
        elif name == "volume":
            colour_volume(block)

    # Immediately after the profile block, so the power readings sit together.
    index = next((i for i, b in enumerate(blocks)
                  if b.get("name") == "read_file"), -1)
    block = gpu_block()
    if block is not None:
        colour_gpu(block)
        blocks.insert(index + 1, block)

    # Theme indicator next to the clock, at the far left.
    mode = ui_mode_block()
    if mode is not None:
        blocks.insert(1 if blocks else 0, mode)

    # Drop empty blocks. A module with format_down = "" still emits a block, and
    # i3bar draws a separator around it — so a disconnected ethernet port shows
    # up as a stray '|' in the middle of the bar.
    return [b for b in blocks if b.get("full_text", "").strip()]


# ── Click actions ──────────────────────────────────────────────────────
# i3bar posts click events back on our stdin once the header says
# "click_events": true. Each is a JSON object with the block's name/instance and
# a button number: 1 left, 2 middle, 3 right, 4 scroll up, 5 scroll down.
#
# Opening a GUI is the honest version of a "dropdown" here — i3bar has no menu
# primitive, and a real popup would mean drawing our own window.
TOGGLE = os.path.expanduser("~/.config/i3/scripts/toggle-app")


def toggle(class_regex, *command):
    """Click once to open, click again to dismiss."""
    return [TOGGLE, class_regex, *command]


CLICK_ACTIONS = {
    ("tztime", 1): toggle("gnome-calendar", "gnome-calendar"),
    # CPU, temperature, load, memory and disk all open gnome-system-monitor —
    # one familiar window rather than a different tool per block — just on the
    # tab that matches what was clicked.
    ("cpu_usage", 1): toggle("gnome-system-monitor", "gnome-system-monitor", "-r"),
    ("cpu_temperature", 1): toggle("gnome-system-monitor", "gnome-system-monitor", "-r"),
    ("load", 1): toggle("gnome-system-monitor", "gnome-system-monitor", "-p"),
    ("memory", 1): toggle("gnome-system-monitor", "gnome-system-monitor", "-r"),
    ("disk_info", 1): toggle("gnome-system-monitor", "gnome-system-monitor", "-f"),
    ("volume", 1): toggle("pavucontrol", "pavucontrol"),
    # The system indicators open their own managers, which is what the tray
    # icons used to be for.
    ("wireless", 1): toggle("nm-connection-editor", "nm-connection-editor"),
    # Right-click the wifi block for Bluetooth: it is the other radio, and it is
    # no longer in the tray.
    ("wireless", 3): toggle("blueman-manager", "blueman-manager"),
    ("battery", 1): toggle("gnome-power-statistics", "gnome-power-statistics"),
    # Volume is the one block where scrolling is the obvious gesture.
    ("volume", 3): ["pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle"],
    ("volume", 4): ["pactl", "set-sink-volume", "@DEFAULT_SINK@", "+5%"],
    ("volume", 5): ["pactl", "set-sink-volume", "@DEFAULT_SINK@", "-5%"],
    # Clicking the theme indicator cycles dark -> light -> fly.
    ("uimode", 1): [os.path.expanduser("~/.config/i3/scripts/ui-mode"), "cycle"],
    # The profile block cycles the profile, same as Super+p.
    ("read_file", 1): [os.path.expanduser(
        "~/.config/i3/scripts/cycle-power-profile")],
    # nvtop when it is installed (live graphs, per-process usage), otherwise a
    # one-shot nvidia-smi. Resolved at click time so installing nvtop upgrades
    # this with no config change.
    #
    # nvidia-settings is deliberately not used: on this PRIME on-demand laptop it
    # detects the offload setup and exits without ever opening a window.
    ("gpu", 1): ["sh", "-c",
                 'F="$HOME/.config/i3/scripts/float-term"; '
                 'if command -v nvtop >/dev/null 2>&1; then '
                 '"$F" nvtop; '
                 'else '
                 '"$F" sh -c "nvidia-smi; echo; '
                 'printf \'[enter to close]\'; read _"; '
                 'fi'],
}


def handle_clicks():
    """Read click events from i3bar and act on them."""
    for line in sys.stdin:
        line = line.strip().lstrip(",")
        if not line or line == "[":
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        action = CLICK_ACTIONS.get((event.get("name"), event.get("button")))
        if not action:
            continue
        try:
            subprocess.Popen(action, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass


def main():
    proc = subprocess.Popen(["i3status", "-c", CONF],
                            stdout=subprocess.PIPE, text=True)

    # The header, with click events switched on. i3status does not set this, so
    # it has to be spliced in — without it i3bar never sends us any clicks.
    header = proc.stdout.readline()
    if not header:
        return
    try:
        head = json.loads(header)
        head["click_events"] = True
        sys.stdout.write(json.dumps(head) + "\n")
    except json.JSONDecodeError:
        sys.stdout.write(header)
    sys.stdout.flush()

    # The opening '[' passes through untouched.
    line = proc.stdout.readline()
    if not line:
        return
    sys.stdout.write(line)
    sys.stdout.flush()

    # Clicks arrive on stdin, independently of i3status's output.
    threading.Thread(target=handle_clicks, daemon=True).start()

    for line in proc.stdout:
        line = line.rstrip("\n")
        prefix = ""
        if line.startswith(","):
            prefix, line = ",", line[1:]

        try:
            blocks = transform(json.loads(line))
        except (json.JSONDecodeError, ValueError):
            # Pass anything unexpected straight through rather than kill the bar.
            sys.stdout.write(prefix + line + "\n")
            sys.stdout.flush()
            continue

        sys.stdout.write(prefix + json.dumps(blocks) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
