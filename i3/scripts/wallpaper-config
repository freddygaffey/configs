#!/usr/bin/env python3
"""Pick, per image and per display size, which part of the photo becomes the wallpaper.

Drag a box over the image; that region is what fills the screen. The box is
locked to the target display's aspect ratio, so what you draw is exactly what
you get — no surprise cropping when it is applied.

Why per display: a 3:2 photo framed nicely for the 16:10 laptop panel is the
wrong crop for a 21:9 ultrawide. One global fit mode cannot serve both, so each
display size gets its own row.

Settings are stored in a sidecar JSON next to the image (photo.png ->
photo.png.json), keyed by display size:

    {
      "version": 1,
      "displays": {
        "2560x1600": {"fit": "crop", "x": 0.10, "y": 0.05, "w": 0.75, "h": 0.75},
        "3440x1440": {"fit": "crop", "x": 0.00, "y": 0.20, "w": 1.00, "h": 0.42},
        "default":   {"fit": "max"}
      }
    }

Coordinates are fractions of the image, not pixels, so a rescaled or re-exported
copy of the same photo keeps its framing.

Sidecar files rather than one central index because the wallpapers live outside
this git repo (they are large binaries, and the repo is public). Keeping the
framing beside the image means moving or backing up the folder takes the
settings with it, and a deleted image cannot leave a stale entry behind.

    wallpaper-config                 open the GUI
    wallpaper-config <image>         open with that image selected
"""
from __future__ import annotations

import json
import subprocess
import sys
import tkinter as tk
from pathlib import Path
from tkinter import ttk

from PIL import Image, ImageTk

SUFFIXES = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".heic", ".heif",
            ".avif", ".tif", ".tiff"}

# Common shapes, so configuring for a monitor you do not have plugged in right
# now is possible. The current display is added at runtime and selected first.
PRESETS = ["2560x1600", "3840x2160", "3440x1440", "2560x1440", "1920x1080"]


def wallpaper_dir() -> Path:
    import os
    if os.environ.get("WALLPAPER_DIR"):
        return Path(os.environ["WALLPAPER_DIR"])
    for candidate in (Path.home() / "Pictures/Wallpapers",
                      Path.home() / ".local/share/wallpapers"):
        if candidate.is_dir():
            return candidate
    return Path.home() / "Pictures/Wallpapers"


def current_display() -> str:
    """Resolution of the primary display, via xrandr."""
    try:
        out = subprocess.run(["xrandr", "--listmonitors"],
                             capture_output=True, text=True, timeout=5).stdout
        for line in out.splitlines():
            if "*" in line:                      # the primary monitor
                # " 0: +*eDP-1 2560/344x1600/215+0+0  eDP-1"
                spec = line.split()[2]
                w = spec.split("/")[0]
                h = spec.split("x")[1].split("/")[0]
                return f"{w}x{h}"
    except Exception:                            # noqa: BLE001 - best effort
        pass
    return "2560x1600"


def list_images(root: Path) -> list[Path]:
    """Every image under the wallpaper dir, deduplicated by real path.

    dark/ and light/ are commonly symlinks into a single all/ folder, so the
    same photo shows up more than once. Resolve and dedupe, or you configure a
    file and the "other" copy looks untouched.
    """
    seen: dict[Path, Path] = {}
    for path in sorted(root.rglob("*")):
        if path.suffix.lower() in SUFFIXES and path.is_file():
            seen.setdefault(path.resolve(), path)
    return sorted(seen.values())


def sidecar_for(image: Path) -> Path:
    return image.with_suffix(image.suffix + ".json")


def load_sidecar(image: Path) -> dict:
    path = sidecar_for(image)
    if not path.exists():
        return {"version": 1, "displays": {}}
    try:
        data = json.loads(path.read_text())
        data.setdefault("displays", {})
        return data
    except (json.JSONDecodeError, OSError):
        # A corrupt sidecar must not make the image unconfigurable. Start fresh;
        # saving overwrites it.
        return {"version": 1, "displays": {}}


def save_sidecar(image: Path, data: dict) -> None:
    sidecar_for(image).write_text(json.dumps(data, indent=2) + "\n")


class Configurator(tk.Tk):
    # Canvas is a fixed size so the drawn box maps predictably to the image.
    CANVAS_W, CANVAS_H = 900, 620
    HANDLE = 10          # px grab radius for corner resize

    def __init__(self, preselect: Path | None = None):
        super().__init__()
        self.title("Wallpaper framing")
        self.root_dir = wallpaper_dir()
        self.images = list_images(self.root_dir)
        self.image: Path | None = None
        self.pil: Image.Image | None = None
        self.photo: ImageTk.PhotoImage | None = None
        # Where the scaled image sits on the canvas, and its scale factor.
        self.off_x = self.off_y = 0
        self.scale = 1.0
        # Selection rect in CANVAS pixels.
        self.rect = [0, 0, 0, 0]
        self.drag_mode: str | None = None
        self.drag_from = (0, 0)

        self._build()
        if not self.images:
            self.status.set(f"No images found under {self.root_dir}")
            return
        target = preselect.resolve() if preselect else None
        index = 0
        for i, path in enumerate(self.images):
            if target and path.resolve() == target:
                index = i
                break
        self.listbox.selection_set(index)
        self.listbox.see(index)
        self.load_image(self.images[index])

    # ---------------------------------------------------------------- layout
    def _build(self) -> None:
        left = ttk.Frame(self, padding=6)
        left.pack(side="left", fill="y")

        ttk.Label(left, text="Images").pack(anchor="w")
        self.listbox = tk.Listbox(left, width=34, height=26, exportselection=False)
        for path in self.images:
            self.listbox.insert("end", path.name)
        self.listbox.pack(fill="y", expand=True)
        self.listbox.bind("<<ListboxSelect>>", self.on_pick)

        right = ttk.Frame(self, padding=6)
        right.pack(side="left", fill="both", expand=True)

        bar = ttk.Frame(right)
        bar.pack(fill="x", pady=(0, 6))
        ttk.Label(bar, text="Display").pack(side="left")
        current = current_display()
        choices = [current] + [p for p in PRESETS if p != current]
        self.display = tk.StringVar(value=current)
        box = ttk.Combobox(bar, textvariable=self.display, values=choices, width=12)
        box.pack(side="left", padx=6)
        box.bind("<<ComboboxSelected>>", lambda _e: self.on_display_change())
        # Typed sizes are allowed, for a monitor not in PRESETS.
        box.bind("<Return>", lambda _e: self.on_display_change())

        ttk.Button(bar, text="Whole image", command=self.reset_rect).pack(side="left", padx=3)
        ttk.Button(bar, text="Save", command=self.save).pack(side="left", padx=3)
        ttk.Button(bar, text="Save + apply", command=self.save_apply).pack(side="left", padx=3)
        ttk.Button(bar, text="Clear", command=self.clear).pack(side="left", padx=3)

        self.canvas = tk.Canvas(right, width=self.CANVAS_W, height=self.CANVAS_H,
                                bg="#161616", highlightthickness=0)
        self.canvas.pack()
        self.canvas.bind("<Button-1>", self.on_press)
        self.canvas.bind("<B1-Motion>", self.on_drag)
        self.canvas.bind("<ButtonRelease-1>", lambda _e: setattr(self, "drag_mode", None))

        self.status = tk.StringVar(value="")
        ttk.Label(right, textvariable=self.status).pack(anchor="w", pady=(6, 0))

        self.bind("<Escape>", lambda _e: self.destroy())
        for key, dx, dy in (("Left", -5, 0), ("Right", 5, 0), ("Up", 0, -5), ("Down", 0, 5)):
            self.bind(f"<{key}>", lambda _e, dx=dx, dy=dy: self.nudge(dx, dy))

    # ----------------------------------------------------------------- image
    def load_image(self, path: Path) -> None:
        self.image = path
        with Image.open(path) as img:
            img = img.convert("RGB")
            # Fit the canvas; these originals are up to 7000px wide and Tk would
            # otherwise hold the whole thing as a bitmap.
            preview = img.copy()
            preview.thumbnail((self.CANVAS_W, self.CANVAS_H), Image.LANCZOS)
            self.pil_size = img.size
        self.pil = preview
        self.scale = preview.width / self.pil_size[0]
        self.off_x = (self.CANVAS_W - preview.width) // 2
        self.off_y = (self.CANVAS_H - preview.height) // 2
        self.photo = ImageTk.PhotoImage(preview)

        self.canvas.delete("all")
        self.canvas.create_image(self.off_x, self.off_y, anchor="nw",
                                 image=self.photo, tags="img")
        self.load_rect_for_display()

    def on_pick(self, _event) -> None:
        selection = self.listbox.curselection()
        if selection:
            self.load_image(self.images[selection[0]])

    # ------------------------------------------------------------------ rect
    def aspect(self) -> float:
        try:
            w, h = self.display.get().lower().split("x")
            return int(w) / int(h)
        except (ValueError, ZeroDivisionError):
            return 16 / 10

    def image_box(self) -> tuple[int, int, int, int]:
        """Canvas bounds of the displayed image."""
        return (self.off_x, self.off_y,
                self.off_x + self.pil.width, self.off_y + self.pil.height)

    def reset_rect(self) -> None:
        """Largest box of the target aspect that fits inside the image."""
        x0, y0, x1, y1 = self.image_box()
        iw, ih = x1 - x0, y1 - y0
        aspect = self.aspect()
        if iw / ih > aspect:          # image is wider than the display
            h = ih
            w = h * aspect
        else:
            w = iw
            h = w / aspect
        self.rect = [x0 + (iw - w) / 2, y0 + (ih - h) / 2,
                     x0 + (iw + w) / 2, y0 + (ih + h) / 2]
        self.redraw()

    def load_rect_for_display(self) -> None:
        """Restore a saved region for this display, else frame the whole image."""
        data = load_sidecar(self.image)
        entry = data["displays"].get(self.display.get())
        if not entry or entry.get("fit") != "crop":
            self.reset_rect()
            self.status.set(f"{self.image.name} — {self.pil_size[0]}x{self.pil_size[1]}"
                            f"  (no saved framing for {self.display.get()})")
            return
        x0, y0, x1, y1 = self.image_box()
        iw, ih = x1 - x0, y1 - y0
        self.rect = [x0 + entry["x"] * iw, y0 + entry["y"] * ih,
                     x0 + (entry["x"] + entry["w"]) * iw,
                     y0 + (entry["y"] + entry["h"]) * ih]
        self.redraw()
        self.status.set(f"{self.image.name} — saved framing for {self.display.get()}")

    def on_display_change(self) -> None:
        if self.image:
            self.load_rect_for_display()

    def redraw(self) -> None:
        self.canvas.delete("sel")
        x0, y0, x1, y1 = self.rect
        # Dim everything outside the selection, so the framing reads at a glance.
        bx0, by0, bx1, by1 = self.image_box()
        for box in ((bx0, by0, bx1, y0), (bx0, y1, bx1, by1),
                    (bx0, y0, x0, y1), (x1, y0, bx1, y1)):
            self.canvas.create_rectangle(*box, fill="#000000", stipple="gray50",
                                         outline="", tags="sel")
        self.canvas.create_rectangle(x0, y0, x1, y1, outline="#78a9ff",
                                     width=2, tags="sel")
        for hx, hy in ((x0, y0), (x1, y0), (x0, y1), (x1, y1)):
            self.canvas.create_rectangle(hx - 4, hy - 4, hx + 4, hy + 4,
                                         fill="#78a9ff", outline="", tags="sel")

    # --------------------------------------------------------------- dragging
    def on_press(self, event) -> None:
        x0, y0, x1, y1 = self.rect
        corners = {"nw": (x0, y0), "ne": (x1, y0), "sw": (x0, y1), "se": (x1, y1)}
        for name, (cx, cy) in corners.items():
            if abs(event.x - cx) <= self.HANDLE and abs(event.y - cy) <= self.HANDLE:
                self.drag_mode = name
                return
        self.drag_mode = "move" if x0 <= event.x <= x1 and y0 <= event.y <= y1 else None
        self.drag_from = (event.x, event.y)

    def on_drag(self, event) -> None:
        if not self.drag_mode:
            return
        bx0, by0, bx1, by1 = self.image_box()
        if self.drag_mode == "move":
            dx = event.x - self.drag_from[0]
            dy = event.y - self.drag_from[1]
            self.drag_from = (event.x, event.y)
            w = self.rect[2] - self.rect[0]
            h = self.rect[3] - self.rect[1]
            # Clamp to the image, so you cannot frame empty canvas.
            nx0 = min(max(self.rect[0] + dx, bx0), bx1 - w)
            ny0 = min(max(self.rect[1] + dy, by0), by1 - h)
            self.rect = [nx0, ny0, nx0 + w, ny0 + h]
        else:
            # Resize from the opposite corner, keeping the display's aspect.
            anchor_x = self.rect[2] if "w" in self.drag_mode else self.rect[0]
            anchor_y = self.rect[3] if "n" in self.drag_mode else self.rect[1]
            w = abs(event.x - anchor_x)
            h = w / self.aspect()
            if h < 20:
                return
            nx0, nx1 = sorted((anchor_x, anchor_x + (w if event.x > anchor_x else -w)))
            ny0, ny1 = sorted((anchor_y, anchor_y + (h if event.y > anchor_y else -h)))
            # Refuse a box that leaves the image rather than silently cropping
            # to nothing at the edge.
            if nx0 < bx0 or ny0 < by0 or nx1 > bx1 or ny1 > by1:
                return
            self.rect = [nx0, ny0, nx1, ny1]
        self.redraw()

    def nudge(self, dx: int, dy: int) -> None:
        if not self.image:
            return
        self.drag_mode = "move"
        self.drag_from = (0, 0)
        bx0, by0, bx1, by1 = self.image_box()
        w = self.rect[2] - self.rect[0]
        h = self.rect[3] - self.rect[1]
        nx0 = min(max(self.rect[0] + dx, bx0), bx1 - w)
        ny0 = min(max(self.rect[1] + dy, by0), by1 - h)
        self.rect = [nx0, ny0, nx0 + w, ny0 + h]
        self.drag_mode = None
        self.redraw()

    # ----------------------------------------------------------------- saving
    def as_fractions(self) -> dict:
        bx0, by0, bx1, by1 = self.image_box()
        iw, ih = bx1 - bx0, by1 - by0
        return {
            "fit": "crop",
            "x": round((self.rect[0] - bx0) / iw, 4),
            "y": round((self.rect[1] - by0) / ih, 4),
            "w": round((self.rect[2] - self.rect[0]) / iw, 4),
            "h": round((self.rect[3] - self.rect[1]) / ih, 4),
        }

    def save(self) -> None:
        if not self.image:
            return
        data = load_sidecar(self.image)
        data["displays"][self.display.get()] = self.as_fractions()
        save_sidecar(self.image, data)
        self.status.set(f"Saved {self.display.get()} -> {sidecar_for(self.image).name}")

    def save_apply(self) -> None:
        self.save()
        if not self.image:
            return
        script = Path(__file__).resolve().parent / "wallpaper"
        try:
            subprocess.run([str(script), "set", str(self.image)], timeout=60, check=False)
            self.status.set(f"Applied {self.image.name}")
        except Exception as exc:                 # noqa: BLE001
            self.status.set(f"Could not apply: {exc}")

    def clear(self) -> None:
        """Forget this display's framing — the image falls back to whole-image fit."""
        if not self.image:
            return
        data = load_sidecar(self.image)
        if data["displays"].pop(self.display.get(), None) is not None:
            save_sidecar(self.image, data)
        self.reset_rect()
        self.status.set(f"Cleared framing for {self.display.get()}")


def main() -> None:
    preselect = Path(sys.argv[1]) if len(sys.argv) > 1 else None
    Configurator(preselect).mainloop()


if __name__ == "__main__":
    main()
