#!/usr/bin/env python3
"""Framing tool for wallpapers: which part of a photo, at what scale, on which display.

    wallpaper-config              serve on 127.0.0.1:8731 and open a browser
    wallpaper-config --port 9000  a different port
    wallpaper-config --no-open    do not launch a browser
    wallpaper-config --host 0.0.0.0   reachable from another machine

A browser rather than a desktop GUI, for three reasons: no toolkit dependency to
install (stdlib http.server only — PIL is used when present but is optional),
drag-and-resize is far less code in the DOM than on a canvas widget, and it can
be driven from the Mac over Tailscale while the wallpaper changes on the Legion.

Why any of this exists: a 3:2 photo framed well for the 16:10 laptop panel is the
wrong crop on a 21:9 monitor, and one global fit cannot serve both. So each image
gets a sidecar JSON keyed by display size, with a row per display:

    photo.png.json
    {
      "version": 1,
      "displays": {
        "2560x1600": {"fit": "crop", "x": 0.10, "y": 0.05, "w": 0.75, "h": 0.75},
        "3440x1440": {"fit": "tile", "zoom": 0.5},
        "1920x1080": {"fit": "max"}
      }
    }

Crop coordinates are fractions of the image rather than pixels, so a rescaled or
re-exported copy of the same photo keeps its framing.

Sidecars rather than one central index because the wallpapers deliberately live
outside this git repo (large binaries, and the repo is public). Framing travels
with the folder, and a deleted image cannot strand an entry behind it.

Binds to 127.0.0.1 by default: this serves the contents of your Pictures folder
and writes files next to them, which has no business being on the network
unasked.
"""
from __future__ import annotations

import argparse
import io
import json
import mimetypes
import os
import re
import subprocess
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

SUFFIXES = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".heic", ".heif",
            ".avif", ".tif", ".tiff"}
PRESETS = ["2560x1600", "3840x2160", "3440x1440", "2560x1440", "1920x1080"]
SCRIPT_DIR = Path(__file__).resolve().parent


def wallpaper_dir() -> Path:
    if os.environ.get("WALLPAPER_DIR"):
        return Path(os.environ["WALLPAPER_DIR"])
    for candidate in (Path.home() / "Pictures/Wallpapers",
                      Path.home() / ".local/share/wallpapers"):
        if candidate.is_dir():
            return candidate
    return Path.home() / "Pictures/Wallpapers"


ROOT = wallpaper_dir()


def current_display() -> str:
    try:
        out = subprocess.run(["xrandr", "--listmonitors"],
                             capture_output=True, text=True, timeout=5).stdout
        for line in out.splitlines():
            if "*" in line:
                spec = line.split()[2]
                return f'{spec.split("/")[0]}x{spec.split("x")[1].split("/")[0]}'
    except Exception:                               # noqa: BLE001 - best effort
        pass
    return "2560x1600"


def list_images() -> list[Path]:
    """Images under the wallpaper dir, deduplicated by real path.

    dark/ and light/ are usually symlinks into one all/ folder, so the same photo
    appears several times. Without dedupe you configure one copy and the others
    look untouched.
    """
    seen: dict[Path, Path] = {}
    if ROOT.is_dir():
        for path in sorted(ROOT.rglob("*")):
            if path.suffix.lower() in SUFFIXES and path.is_file():
                seen.setdefault(path.resolve(), path)
    return sorted(seen.values())


def safe_image(raw: str) -> Path | None:
    """Resolve a requested path, refusing anything outside the wallpaper dir.

    This server hands out file contents, so a path from the query string is
    untrusted input: without this check, ?path=../../.ssh/id_ed25519 would be
    served happily.
    """
    try:
        path = Path(raw).resolve()
    except (OSError, ValueError):
        return None
    if path.suffix.lower() not in SUFFIXES or not path.is_file():
        return None
    try:
        path.relative_to(ROOT.resolve())
    except ValueError:
        return None
    return path


def sidecar_for(image: Path) -> Path:
    return image.with_suffix(image.suffix + ".json")


def load_sidecar(image: Path) -> dict:
    path = sidecar_for(image)
    if not path.exists():
        return {"version": 1, "displays": {}}
    try:
        data = json.loads(path.read_text())
        data.setdefault("displays", {})
        return data
    except (json.JSONDecodeError, OSError):
        # A corrupt sidecar must not make the image unconfigurable.
        return {"version": 1, "displays": {}}


def image_size(image: Path) -> list[int]:
    """Original pixel dimensions, without decoding the whole image.

    The browser only ever sees a downscaled preview, so it cannot measure this
    itself — and Center and Tile are defined in terms of real screen pixels, so
    getting it wrong makes those previews meaningless.
    """
    try:
        from PIL import Image
        with Image.open(image) as img:
            return list(img.size)
    except Exception:                               # noqa: BLE001
        return [0, 0]


def preview_bytes(image: Path, box: int = 1400) -> tuple[bytes, str]:
    """A downscaled preview, so the browser is not handed a 7000px original.

    Falls back to the raw file when PIL is missing — correct, just slower.
    """
    try:
        from PIL import Image
    except ImportError:
        return image.read_bytes(), mimetypes.guess_type(image.name)[0] or "image/png"
    try:
        with Image.open(image) as img:
            img = img.convert("RGB")
            img.thumbnail((box, box), Image.LANCZOS)
            buf = io.BytesIO()
            img.save(buf, format="JPEG", quality=88)
            return buf.getvalue(), "image/jpeg"
    except Exception:                               # noqa: BLE001
        return image.read_bytes(), mimetypes.guess_type(image.name)[0] or "image/png"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_args):                  # quiet; this is a local tool
        pass

    # ------------------------------------------------------------------ helpers
    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, obj, code: int = 200) -> None:
        self._send(code, json.dumps(obj).encode(), "application/json")

    # ---------------------------------------------------------------------- GET
    def do_GET(self) -> None:                       # noqa: N802 - stdlib API
        url = urlparse(self.path)
        query = parse_qs(url.query)

        if url.path == "/":
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif url.path == "/api/state":
            images = list_images()
            self._json({
                "root": str(ROOT),
                "current": current_display(),
                "presets": PRESETS,
                "images": [{"path": str(p), "name": p.name} for p in images],
            })
        elif url.path == "/api/image":
            image = safe_image(query.get("path", [""])[0])
            if not image:
                self._json({"error": "not found"}, 404)
                return
            body, ctype = preview_bytes(image)
            self._send(200, body, ctype)
        elif url.path == "/api/marks":
            # Which images already have an entry for this display. One request
            # instead of 70, so the list can show progress without a stampede.
            display = query.get("display", [""])[0]
            configured = {}
            for path in list_images():
                entry = load_sidecar(path)["displays"].get(display)
                if entry:
                    configured[str(path)] = entry.get("fit", "max")
            self._json({"display": display, "configured": configured})
        elif url.path == "/api/config":
            image = safe_image(query.get("path", [""])[0])
            if not image:
                self._json({"error": "not found"}, 404)
                return
            data = load_sidecar(image)
            data["size"] = image_size(image)
            self._json(data)
        else:
            self._json({"error": "not found"}, 404)

    # --------------------------------------------------------------------- POST
    def do_POST(self) -> None:                      # noqa: N802 - stdlib API
        url = urlparse(self.path)
        length = int(self.headers.get("Content-Length", 0))
        try:
            payload = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError:
            self._json({"error": "bad json"}, 400)
            return

        image = safe_image(payload.get("path", ""))
        if not image:
            self._json({"error": "not found"}, 404)
            return

        if url.path == "/api/save":
            display = str(payload.get("display", "")).strip()
            if not re.fullmatch(r"\d{2,5}x\d{2,5}", display):
                self._json({"error": "bad display"}, 400)
                return
            entry = payload.get("entry")
            data = load_sidecar(image)
            if entry is None:
                data["displays"].pop(display, None)
            else:
                data["displays"][display] = entry
            sidecar_for(image).write_text(json.dumps(data, indent=2) + "\n")
            self._json({"ok": True, "sidecar": str(sidecar_for(image))})

        elif url.path == "/api/apply":
            try:
                subprocess.run([str(SCRIPT_DIR / "wallpaper"), "set", str(image)],
                               timeout=120, check=False)
                self._json({"ok": True})
            except Exception as exc:                # noqa: BLE001
                self._json({"error": str(exc)}, 500)
        else:
            self._json({"error": "not found"}, 404)


PAGE = r"""<!doctype html>
<meta charset="utf-8">
<title>Wallpaper framing</title>
<style>
  :root {
    --bg:#161616; --panel:#1f1f22; --line:#2a2a2e; --fg:#f2f4f8;
    --mut:#8b8b90; --accent:#78a9ff; --ok:#25be6a;
  }
  * { box-sizing:border-box; }
  body { margin:0; height:100vh; display:flex; background:var(--bg); color:var(--fg);
         font:13px/1.5 "JetBrains Mono", ui-monospace, monospace; overflow:hidden; }

  aside { width:250px; flex:none; border-right:1px solid var(--line);
          display:flex; flex-direction:column; }
  aside h2 { margin:0; padding:10px 12px; font-size:11px; color:var(--mut);
             border-bottom:1px solid var(--line); font-weight:normal; }
  #list { overflow-y:auto; flex:1; }
  #list div { padding:5px 12px; cursor:pointer; white-space:nowrap;
              overflow:hidden; text-overflow:ellipsis; border-left:3px solid transparent; }
  #list div:hover { background:var(--panel); }
  #list div.sel { background:var(--panel); border-left-color:var(--accent); }
  #list div.has { color:var(--ok); }

  main { flex:1; display:flex; flex-direction:column; min-width:0; }
  .bar { display:flex; gap:8px; align-items:center; padding:8px 12px;
         border-bottom:1px solid var(--line); flex-wrap:wrap; }
  select, button {
    background:var(--panel); color:var(--fg); border:1px solid var(--line);
    border-radius:4px; padding:4px 8px; font:inherit; cursor:pointer;
  }
  button:hover { border-color:var(--accent); }
  button.primary { background:var(--accent); color:var(--bg); border-color:var(--accent); }
  label { color:var(--mut); }

  /* The frame IS the screen. It never moves; the image moves behind it. */
  #stageWrap { flex:1; display:grid; place-items:center; overflow:hidden; padding:20px; }
  #frame { position:relative; overflow:hidden; background:#161616;
           box-shadow:0 0 0 1px var(--line), 0 0 0 9999px rgba(10,10,10,.62);
           cursor:grab; touch-action:none; }
  #frame.grabbing { cursor:grabbing; }
  #frame img { position:absolute; transform-origin:0 0; display:block;
               image-rendering:auto; user-select:none; -webkit-user-drag:none; }
  #tile { position:absolute; inset:0; background-repeat:repeat; }
  #hint { position:absolute; left:0; right:0; bottom:0; padding:4px 8px;
          background:rgba(0,0,0,.55); color:var(--mut); font-size:11px;
          pointer-events:none; }
  #status { padding:7px 12px; border-top:1px solid var(--line); color:var(--mut);
            display:flex; gap:16px; }
  #count { color:var(--ok); }
  .hide { display:none !important; }
  kbd { background:var(--panel); border:1px solid var(--line); border-radius:3px;
        padding:0 4px; color:var(--fg); }
</style>

<aside>
  <h2 id="root">images</h2>
  <div id="list"></div>
</aside>

<main>
  <div class="bar">
    <label>display</label><select id="display"></select>
    <label>fit</label>
    <select id="fit">
      <option value="crop">Crop — pan &amp; zoom</option>
      <option value="fill">Fill Screen</option>
      <option value="max">Fit to Screen</option>
      <option value="stretch">Stretch to Fill</option>
      <option value="center">Center</option>
      <option value="tile">Tile</option>
    </select>
    <span id="zoomWrap" class="hide">
      <label>scale</label><span id="zoomVal">100%</span>
    </span>
    <button id="reset">reset</button>
    <button id="clear">clear</button>
    <button id="apply">apply</button>
    <button id="next" class="primary">save + next &nbsp;<kbd>space</kbd></button>
  </div>

  <div id="stageWrap">
    <div id="frame">
      <img id="img" alt="">
      <div id="tile" class="hide"></div>
      <div id="hint">drag to pan · scroll to zoom · <kbd>space</kbd> save+next · <kbd>0</kbd> reset</div>
    </div>
  </div>

  <div id="status">
    <span id="msg">loading…</span>
    <span id="count"></span>
  </div>
</main>

<script>
const $ = s => document.querySelector(s);
let state = null, image = null, cfg = null, idx = 0;

// View transform: the image is drawn at `scale`, with its top-left at (ox, oy)
// relative to the frame's top-left. The frame is the screen, so this is exactly
// "which part of the photo is visible" — and converting it to a stored crop is
// pure arithmetic, no separate rectangle to keep in sync.
let scale = 1, ox = 0, oy = 0;
let nat = {w:1, h:1};        // size of the DOWNSCALED preview we loaded
let orig = {w:1, h:1};       // size of the original file on disk

// Frame pixels per real screen pixel. The frame stands in for the display, so
// this is the factor that makes Center and Tile previews truthful: those modes
// are defined in real screen pixels, not in preview pixels.
const framePx = () => $("#frame").clientWidth / dispWH()[0];

// Scale at which the preview image is drawn 1:1 on the real screen.
const nativeScale = () => framePx() * (orig.w / nat.w);

// Smallest scale that still covers the frame, and the largest that fits inside.
function coverScale() {
  const f = $("#frame");
  return Math.max(f.clientWidth / nat.w, f.clientHeight / nat.h);
}
function containScale() {
  const f = $("#frame");
  return Math.min(f.clientWidth / nat.w, f.clientHeight / nat.h);
}

const msg = t => $("#msg").textContent = t;
const dispWH = () => $("#display").value.split("x").map(Number);

// Frame size on screen: the display's aspect, as large as fits the stage.
function sizeFrame() {
  const [dw, dh] = dispWH();
  const pad = 40;
  const availW = $("#stageWrap").clientWidth - pad;
  const availH = $("#stageWrap").clientHeight - pad;
  let w = availW, h = w * dh / dw;
  if (h > availH) { h = availH; w = h * dw / dh; }
  $("#frame").style.width = Math.round(w) + "px";
  $("#frame").style.height = Math.round(h) + "px";
}

async function boot() {
  state = await (await fetch("/api/state")).json();
  $("#root").textContent = state.root;
  const opts = [state.current, ...state.presets.filter(p => p !== state.current)];
  $("#display").innerHTML = opts.map(d =>
    `<option ${d === state.current ? "selected" : ""}>${d}</option>`).join("");
  $("#list").innerHTML = state.images.map((im, i) =>
    `<div data-i="${i}" title="${im.name}">${im.name}</div>`).join("");
  $("#list").onclick = e => { const d = e.target.closest("[data-i]"); if (d) pick(+d.dataset.i); };
  sizeFrame();
  if (state.images.length) { await refreshMarks(); pick(0); }
  else msg("No images under " + state.root);
}

// Which images already have framing for this display — so you can see what is
// left across 70 files, and skip the ones that are done.
async function refreshMarks() {
  const d = $("#display").value;
  const marks = await (await fetch("/api/marks?display=" + encodeURIComponent(d))).json();
  let done = 0;
  [...$("#list").children].forEach((el, i) => {
    const has = marks.configured[state.images[i].path];
    el.classList.toggle("has", !!has);
    if (has) done++;
  });
  $("#count").textContent = `${done}/${state.images.length} framed for ${d}`;
}

async function pick(i) {
  idx = Math.max(0, Math.min(i, state.images.length - 1));
  image = state.images[idx];
  [...$("#list").children].forEach((d, j) => d.classList.toggle("sel", j === idx));
  $("#list").children[idx]?.scrollIntoView({block:"nearest"});

  const img = $("#img");
  await new Promise(res => {
    img.onload = res; img.onerror = res;
    img.src = "/api/image?path=" + encodeURIComponent(image.path);
  });
  nat = {w: img.naturalWidth, h: img.naturalHeight};
  cfg = await (await fetch("/api/config?path=" + encodeURIComponent(image.path))).json();
  orig = {w: (cfg.size && cfg.size[0]) || nat.w, h: (cfg.size && cfg.size[1]) || nat.h};
  loadEntry();
}

function clamp() {
  // Only Crop clamps. The other fits are allowed to letterbox, because that is
  // what they genuinely do on screen — hiding it here is what made the preview
  // lie in the first place.
  if ($("#fit").value !== "crop") return;
  const f = $("#frame");
  const w = nat.w * scale, h = nat.h * scale;
  ox = Math.min(0, Math.max(ox, f.clientWidth - w));
  oy = Math.min(0, Math.max(oy, f.clientHeight - h));
  if (w < f.clientWidth) ox = (f.clientWidth - w) / 2;
  if (h < f.clientHeight) oy = (f.clientHeight - h) / 2;
}

function centreAt(s) {
  const f = $("#frame");
  scale = s;
  ox = (f.clientWidth - nat.w * s) / 2;
  oy = (f.clientHeight - nat.h * s) / 2;
}

function draw() {
  clamp();
  const img = $("#img"), f = $("#frame"), fit = $("#fit").value;
  if (fit === "stretch") {
    // Distorts to fill, so width and height are set independently rather than
    // through a uniform scale.
    img.style.width = f.clientWidth + "px";
    img.style.height = f.clientHeight + "px";
    img.style.transform = "translate(0px, 0px)";
  } else {
    img.style.width = nat.w + "px";
    img.style.height = nat.h + "px";
    img.style.transform = `translate(${ox}px, ${oy}px) scale(${scale})`;
  }
  // Report zoom against 1:1 on the real screen, which is the number that means
  // something — 100% is one image pixel per screen pixel.
  $("#zoomVal").textContent = Math.round(scale / nativeScale() * 100) + "%";
}

// Place the image the way this fit actually places it on screen.
function renderFit() {
  const fit = $("#fit").value, f = $("#frame");
  const zoom = +($("#zoomVal").dataset.zoom || 1);
  if (fit === "fill")        centreAt(coverScale());
  else if (fit === "max")    centreAt(containScale());
  else if (fit === "center") centreAt(nativeScale() * zoom);
  else if (fit === "tile") {
    $("#tile").style.backgroundImage = `url(${$("#img").src})`;
    $("#tile").style.backgroundSize = `${nat.w * nativeScale() * zoom}px auto`;
  }
  draw();
}

function resetView() {
  const fit = $("#fit").value;
  if (fit === "crop") { centreAt(coverScale()); draw(); }
  else { $("#zoomVal").dataset.zoom = 1; renderFit(); }
}

// View -> stored crop. Fractions of the image, so a rescaled copy of the same
// photo keeps its framing.
function cropFromView() {
  const f = $("#frame");
  const w = nat.w * scale, h = nat.h * scale;
  return {
    fit: "crop",
    x: +Math.max(0, -ox / w).toFixed(4),
    y: +Math.max(0, -oy / h).toFixed(4),
    w: +Math.min(1, f.clientWidth / w).toFixed(4),
    h: +Math.min(1, f.clientHeight / h).toFixed(4),
  };
}

// Stored crop -> view, so reopening an image shows exactly what you framed.
function viewFromCrop(e) {
  const f = $("#frame");
  scale = f.clientWidth / (e.w * nat.w);
  ox = -e.x * nat.w * scale;
  oy = -e.y * nat.h * scale;
  draw();
}

function loadEntry() {
  const entry = (cfg.displays || {})[$("#display").value];
  $("#fit").value = entry?.fit || "max";
  $("#zoomVal").dataset.zoom = entry?.zoom ?? 1;
  onFit();
  if (entry?.fit === "crop") viewFromCrop(entry);
  msg(entry ? `${image.name} — saved ${entry.fit}` : `${image.name} — unset`);
}

function onFit() {
  const fit = $("#fit").value;
  const isCrop = fit === "crop";
  const hasZoom = fit === "tile" || fit === "center";
  $("#img").classList.toggle("hide", fit === "tile");
  $("#tile").classList.toggle("hide", fit !== "tile");
  $("#zoomWrap").classList.toggle("hide", !(isCrop || hasZoom));
  $("#frame").style.cursor = isCrop ? "grab" : "default";
  $("#hint").textContent = isCrop
    ? "drag to pan · scroll to zoom · space save+next · 0 reset"
    : (hasZoom ? "scroll to scale · space save+next"
               : "no adjustment for this fit · space save+next");
  renderFit();
}

function entryFromUI() {
  const fit = $("#fit").value;
  if (fit === "crop") return cropFromView();
  if (fit === "tile" || fit === "center")
    return {fit, zoom: +(+($("#zoomVal").dataset.zoom || 1)).toFixed(3)};
  return {fit};
}

async function save() {
  const entry = entryFromUI(), display = $("#display").value;
  const r = await (await fetch("/api/save", {method:"POST", body: JSON.stringify(
    {path: image.path, display, entry})})).json();
  if (r.error) { msg("error: " + r.error); return false; }
  cfg.displays = cfg.displays || {};
  cfg.displays[display] = entry;
  $("#list").children[idx].classList.add("has");
  const done = [...$("#list").children].filter(e => e.classList.contains("has")).length;
  $("#count").textContent = `${done}/${state.images.length} framed for ${display}`;
  return true;
}

async function apply() {
  if (!await save()) return;
  msg("applying…");
  const a = await (await fetch("/api/apply", {method:"POST",
    body: JSON.stringify({path: image.path})})).json();
  msg(a.error ? "apply failed: " + a.error : `applied ${image.name}`);
}

// ----- pan and zoom --------------------------------------------------------
let drag = null;
$("#frame").addEventListener("pointerdown", e => {
  if ($("#fit").value !== "crop") return;
  drag = {x: e.clientX, y: e.clientY, ox, oy};
  $("#frame").classList.add("grabbing");
  $("#frame").setPointerCapture(e.pointerId);
});
addEventListener("pointermove", e => {
  if (!drag) return;
  ox = drag.ox + (e.clientX - drag.x);
  oy = drag.oy + (e.clientY - drag.y);
  draw();
});
addEventListener("pointerup", () => { drag = null; $("#frame").classList.remove("grabbing"); });

// Zoom at the cursor, not the centre — otherwise zooming in on a detail walks
// it off screen and you have to chase it with the mouse.
$("#frame").addEventListener("wheel", e => {
  e.preventDefault();
  const fit = $("#fit").value;
  const rect = $("#frame").getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  const factor = Math.exp(-e.deltaY * 0.0015);
  if (fit === "tile" || fit === "center") {
    const z = Math.min(Math.max((+($("#zoomVal").dataset.zoom || 1)) * factor, 0.05), 8);
    $("#zoomVal").dataset.zoom = z;
    renderFit();
    return;
  }
  if (fit !== "crop") return;
  const next = Math.min(Math.max(scale * factor, coverScale()), nativeScale() * 8);
  // Keep the pixel under the cursor fixed, or zooming in on a detail walks it
  // off screen and you chase it with the mouse.
  ox = mx - (mx - ox) * (next / scale);
  oy = my - (my - oy) * (next / scale);
  scale = next;
  draw();
}, {passive:false});

// ----- keyboard: the whole point, with ~70 images to get through ------------
addEventListener("keydown", async e => {
  if (e.target.tagName === "SELECT") return;
  const step = e.shiftKey ? 60 : 15;
  switch (e.key) {
    case " ":  e.preventDefault(); if (await save()) pick(idx + 1); return;
    case "Enter": e.preventDefault(); apply(); return;
    case "0": resetView(); return;
  }
  if (e.key === "]" || e.key === "n") { pick(idx + 1); return; }
  if (e.key === "[" || e.key === "p") { pick(idx - 1); return; }
  if ($("#fit").value !== "crop") return;
  const moves = {ArrowLeft:[step,0], ArrowRight:[-step,0], ArrowUp:[0,step], ArrowDown:[0,-step]};
  const m = moves[e.key];
  if (m) { ox += m[0]; oy += m[1]; draw(); e.preventDefault(); }
});

$("#display").onchange = async () => { sizeFrame(); await refreshMarks(); loadEntry(); };
$("#fit").onchange = onFit;
$("#reset").onclick = resetView;
$("#apply").onclick = apply;
$("#next").onclick = async () => { if (await save()) pick(idx + 1); };
$("#clear").onclick = async () => {
  await fetch("/api/save", {method:"POST", body: JSON.stringify(
    {path: image.path, display: $("#display").value, entry: null})});
  delete (cfg.displays || {})[$("#display").value];
  $("#list").children[idx].classList.remove("has");
  resetView(); msg("cleared " + $("#display").value);
};
addEventListener("resize", () => { sizeFrame(); draw(); });

boot();
</script>
"""


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--port", type=int, default=8731)
    parser.add_argument("--host", default="127.0.0.1",
                        help="0.0.0.0 to reach it from another machine")
    parser.add_argument("--no-open", action="store_true")
    args = parser.parse_args()

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    url = f"http://{'127.0.0.1' if args.host == '0.0.0.0' else args.host}:{args.port}/"
    print(f"Wallpaper framing on {url}   (images: {ROOT})")
    print("Ctrl+C to stop.")
    if not args.no_open:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
