#!/usr/bin/env sh
# Bluetooth state for the i3 bar: powered, and how many devices are connected.
#
# Lives in the bar rather than the tray so the system indicators — volume, wifi,
# bluetooth — sit together. i3bar orders tray icons by registration order and
# offers no way to change it, so application icons (Discord, Bitwarden) kept
# getting interleaved with them.
#
# bluetoothctl rather than nmcli-style scanning: it answers from the local
# daemon in ~25ms, which is fine to call every few seconds.

set -u

command -v bluetoothctl >/dev/null 2>&1 || exit 0

powered=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2; exit}')
[ -n "$powered" ] || { printf 'bt --'; exit 0; }

if [ "$powered" != "yes" ]; then
    printf 'bt off'
    exit 0
fi

count=$(bluetoothctl devices Connected 2>/dev/null | grep -c '^Device' || true)
if [ "${count:-0}" -gt 0 ]; then
    printf 'bt %s' "$count"
else
    printf 'bt on'
fi
