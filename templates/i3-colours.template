# GENERATED — do not edit ~/.config/i3/colours.conf by hand.
# i3/scripts/ui-mode renders this template with one of i3/palette-*.env and
# writes the result, then runs `i3-msg restart` (which preserves your layout).
#
# Literal hex rather than i3 variables, and that is the whole reason this is a
# template: i3's `include` does NOT expose the included file's variables to the
# including file — `set $bg` here would leave every colour below as
# "Could not parse color: $bg". Literals cross the include boundary fine.
#
# The whole bar block lives here because `colors` has to sit inside it, and i3
# has no way to include a fragment into an existing block.

#                       border   background  text    indicator  child_border
# child_border is the visible edge. Focused gets the accent, unfocused gets the
# panel shade — a deliberately large step, since with no compositor this border
# is the only indication of which window has focus.
client.focused          @ui_accent@ @ui_accent@    @ui_bg@    @ui_accent@   @ui_accent@
client.focused_inactive @ui_panel@  @ui_panel@     @ui_fg@    @ui_panel@    @ui_panel@
client.unfocused        @ui_panel@  @ui_bg@        @ui_dim@   @ui_bg@       @ui_panel@
client.urgent           @ui_urgent@ @ui_urgent@    @ui_bg@    @ui_urgent@   @ui_urgent@

bar {
    status_command ~/.config/i3/scripts/status ~/.config/i3/i3status.conf
    position top
    font pango:JetBrainsMono Nerd Font 10
    tray_output primary
    separator_symbol " | "
    tray_padding 2
    colors {
        # panel, not bg: i3bar has no border option, so the only way to separate
        # the bar from the windows below it is to make it a different shade.
        background @ui_panel@
        statusline @ui_fg@
        # dim, NOT panel: the bar's background is panel, so a panel-coloured
        # separator is invisible and the blocks read as one padded run of text
        # with no dividers at all.
        separator  @ui_dim@
        #                  border    background  text
        focused_workspace  @ui_accent@  @ui_accent@    @ui_bg@
        active_workspace   @ui_panel@   @ui_panel@     @ui_fg@
        inactive_workspace @ui_bg@      @ui_bg@        @ui_dim@
        urgent_workspace   @ui_urgent@  @ui_urgent@    @ui_bg@
    }
}
