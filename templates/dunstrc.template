# GENERATED — do not edit ~/.config/dunst/dunstrc by hand.
# Rendered from templates/dunstrc.template with a themes/*.env palette by
# i3/scripts/ui-mode.
#
# i3 has no notification daemon of its own, so without dunst nothing on this
# desktop can tell you anything — no volume OSD, no low battery, no app alerts.

[global]
    monitor = 0
    follow = mouse
    width = (300, 480)
    height = 300
    origin = top-right
    offset = 12x40
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "@accent@"
    separator_color = frame
    corner_radius = 4

    sort = yes
    font = JetBrains Mono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "@panel@"
    foreground = "@dim@"
    frame_color = "@panel@"
    timeout = 5

[urgency_normal]
    background = "@bg@"
    foreground = "@fg@"
    frame_color = "@accent@"
    timeout = 8

[urgency_critical]
    background = "@bg@"
    foreground = "@fg@"
    frame_color = "@urgent@"
    timeout = 0
