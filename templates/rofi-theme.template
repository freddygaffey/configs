/* GENERATED — do not edit ~/.config/rofi/config.rasi by hand.
 * Rendered from templates/rofi-theme.template with a themes/<name>.env palette by
 * i3/scripts/ui-mode.
 *
 * Behaviour and colours are in ONE file on purpose: splitting them needed a
 * @theme include, and rofi would not load it from any form tried.
 *
 * NEVER write a slash-star sequence inside these comments. rofi's rasi parser
 * nests block comments, so one opens a second comment, the closing marker ends
 * only the inner one, and the OUTER comment swallows the rest of the file —
 * silently. That is what made this config appear to be ignored entirely: a
 * comment mentioning a glob pattern for the themes directory.
 *
 * Uses the ui_* roles, the same neutral slate as the i3 bar — so the launcher
 * matches the bar rather than the terminal, and needs no re-render when the
 * mode changes.
 *
 * The alpha suffix on the background (f5 = 96%) leaves only a hint of the
 * wallpaper. 87% was tried first and washed out badly over a bright image — a
 * launcher sits on top of the wallpaper, unlike the bar which sits against the
 * screen edge, so it takes far more of the image behind it.
 */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Yaru";
    drun-display-format: "{name}";
    display-drun:        "apps";
    display-run:         "run";
    display-window:      "windows";
    kb-cancel:           "Escape,Super+d";
    /* Ctrl-n/p alongside the arrows, matching tmux and readline habits. */
    kb-row-down:         "Down,Control+n";
    kb-row-up:           "Up,Control+p";
}

* {
    bg:       @ui_menu_bg@f5;
    bg-alt:   @ui_panel@;
    fg:       @ui_fg@;
    accent:   @ui_accent@;
    dim:      @ui_dim@;
    urgent:   @ui_urgent@;
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    6px;
    width:            42%;
    padding:          0;
}

mainbox { children: [ inputbar, listview ]; padding: 8px; spacing: 8px; }

inputbar {
    background-color: @bg-alt;
    padding:          10px 12px;
    border-radius:    4px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt  { text-color: @accent; }
entry   { placeholder: "…"; placeholder-color: @dim; }

listview { lines: 10; scrollbar: false; spacing: 2px; }

element { padding: 8px 12px; border-radius: 4px; }
element normal normal   { text-color: @fg;     }
element normal urgent   { text-color: @urgent; }
element normal active   { text-color: @accent; }
element selected normal { background-color: @accent; text-color: @ui_bg@; }
element selected urgent { background-color: @urgent; text-color: @ui_bg@; }
element selected active { background-color: @accent; text-color: @ui_bg@; }

element-icon { size: 20px; padding: 0 8px 0 0; }
element-text { vertical-align: 0.5; }
