/* GENERATED — do not edit ~/.config/rofi/config.rasi by hand.
 * Rendered from templates/rofi-theme.template with a themes/*.env palette by
 * i3/scripts/ui-mode.
 *
 * Behaviour and colours are in ONE file on purpose. Splitting them meant a
 * @theme include, and rofi would not load it from any form tried — "theme",
 * an absolute path, or @import — while `rofi -dump-theme` prints only a header
 * so there was no way to confirm what it had read. One file removes the
 * question.
 *
 * Uses the ui_* roles, the same neutral slate as the i3 bar — so the launcher
 * matches the bar rather than the terminal, and needs no re-render when the
 * mode changes.
 *
 * The alpha suffix on the background (dd = 87%) is what makes it translucent.
 * That needs a compositor: picom is started by i3. Without one it simply renders
 * opaque rather than breaking.
 */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Yaru";
    drun-display-format: "{name}";
    display-drun:        "apps";
    display-run:         "run";
    display-window:      "windows";
    kb-cancel:           "Escape,Super+d";
    /* Ctrl-n/p alongside the arrows, matching tmux and readline habits. */
    kb-row-down:         "Down,Control+n";
    kb-row-up:           "Up,Control+p";
}

* {
    bg:       @ui_bg@dd;
    bg-alt:   @ui_panel@ee;
    fg:       @ui_fg@;
    accent:   @ui_accent@;
    dim:      @ui_dim@;
    urgent:   @ui_urgent@;
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    6px;
    width:            42%;
    padding:          0;
}

mainbox { children: [ inputbar, listview ]; padding: 8px; spacing: 8px; }

inputbar {
    background-color: @bg-alt;
    padding:          10px 12px;
    border-radius:    4px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt  { text-color: @accent; }
entry   { placeholder: "…"; placeholder-color: @dim; }

listview { lines: 10; scrollbar: false; spacing: 2px; }

element { padding: 8px 12px; border-radius: 4px; }
element normal normal   { text-color: @fg;     }
element normal urgent   { text-color: @urgent; }
element normal active   { text-color: @accent; }
element selected normal { background-color: @accent; text-color: @ui_bg@; }
element selected urgent { background-color: @urgent; text-color: @ui_bg@; }
element selected active { background-color: @accent; text-color: @ui_bg@; }

element-icon { size: 20px; padding: 0 8px 0 0; }
element-text { vertical-align: 0.5; }
