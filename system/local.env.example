# Copy to system/local.env if you want to pin any of these. local.env is
# gitignored. Nothing here is secret — it is preferences only.
#
#   cp system/local.env.example system/local.env

# Cap battery charge at ~60% (ideapad conservation mode). Right for a machine
# that lives plugged in; turn off before taking it anywhere.
ENABLE_CONSERVATION=0

# Skip individual steps:
# SKIP_SUSPEND SKIP_UDEV_POWER SKIP_NVIDIA_PERSIST SKIP_VAAPI
# SKIP_SNAP_RETAIN SKIP_TRACKER
