# nightfox — the light-mode terminal. Values from the installed nightfox plugin,
# so the terminal, tmux and nvim match exactly rather than approximately.
#
# This palette exists because "light mode" here means light APPS with a terminal
# that is neither of the other two: not the near-black of dark mode, not the
# off-white of fly. A blue-tinted dark reads as a deliberate third state rather
# than "dark mode with the browser wrong", and it sits comfortably next to white
# app windows in a way that pure black does not.
name=nightfox

# Claude Code's theme. It runs IN the terminal, so it follows the TERMINAL's
# palette, not the desktop's — which is why this is set per palette rather than
# per mode, and why "auto" is wrong here: auto follows the system colour scheme,
# and in light mode that is light while this terminal is dark.
# Claude Code takes a named theme, not hex: dark | light (or their -daltonized
# and -ansi variants).
claude_theme=dark

# Desktop background. Unset, the root window is filled with bg.
#wallpaper=

# Opaque. Transparency over a photographic wallpaper is the reason text was hard
# to read: the eye keeps resolving the image behind the glyphs, which is exactly
# the distraction you notice when a window is focused and you are trying to read
# it. Firefox never had the problem because it paints an opaque background.
#
# The desktop still shows through the gaps and on empty workspaces, which is
# where a wallpaper is actually worth seeing.
#
# Set below 1.0 to bring it back; 0.95 is about the most that stays legible over
# a busy image.
term_opacity=1.0

bg=#192330
# Brighter than nightfox's own fg1 (#cdcecf, 10.1:1 on this background).
# carbonfox runs at 16.4:1, so the default felt washed out by comparison — and
# transparency plus the inactive dim take more off it again. #e4e4e5 gives
# 12.5:1, which holds up when the window is not focused.
fg=#e4e4e5
accent=#719cd6
dim=#738091
urgent=#c94f6d
panel=#212e3f
sel=#2b3b51
url=#63cdcf

color0=#393b44
color1=#c94f6d
color2=#81b29a
color3=#dbc074
color4=#719cd6
color5=#9d79d6
color6=#63cdcf
color7=#dfdfe0
color8=#575860
color9=#d16983
color10=#8ebaa4
color11=#e0c989
color12=#86abdc
color13=#baa1e2
color14=#7ad5d6
color15=#e4e4e5

# ── i3's own chrome — the same in every mode ───────────────────────────
# Identical across all three palettes on purpose: i3 reads colours only at
# config-parse time, so differing values would force an i3-msg restart on every
# mode switch, which tears down and rebuilds the WM. Keep these in sync.
ui_bg=#23232b
ui_fg=#e8e8ee
ui_accent=#78a9ff
ui_dim=#8a8a96
ui_urgent=#ee5396
ui_panel=#2f2f38

# rofi's own base — darker than the bar, because a launcher sits ON TOP of the
# wallpaper rather than against a screen edge, so it needs to read as a panel
# rather than a tint over a photograph.
ui_menu_bg=#15151a
