# carbonfox — the dark palette. THE definition; everything else is rendered
# from it, so this is the only place these hex values appear.
#
# Consumed by i3/scripts/ui-mode, which renders templates/*.template with these
# values. Adding a theme means adding a file like this one — no template or
# script changes.
#
# name= must match a nightfox colorscheme, since nvim loads it by name rather
# than being handed colours.
name=carbonfox

# Terminal background opacity. Not solid: the wallpapers are photographs, and
# letting them through a dark terminal reads well without hurting legibility the
# way it would over a busy light background.
term_opacity=0.86

# Desktop background. Leave wallpaper unset to use a plain fill of bg, which is
# what a tiling WM mostly shows anyway — you rarely see the root window. Point it
# at an image file to use one instead; ~ is expanded.
#wallpaper=

# UI roles — used by the i3 template.
bg=#161616
fg=#f2f4f8
accent=#78a9ff
dim=#6b6b6b
urgent=#ee5396
panel=#2a2a2a
sel=#2a2a2a
url=#33b1ff

# ANSI 0-15 — used by the terminal template.
color0=#161616
color1=#ee5396
color2=#25be6a
color3=#08bdba
color4=#78a9ff
color5=#be95ff
color6=#33b1ff
color7=#dfdfe0
color8=#6b6b6b
color9=#f16da6
color10=#46c880
color11=#2dc7c4
color12=#8cb6ff
color13=#c8a5ff
color14=#52bdff
color15=#f2f4f8

# ── i3's own chrome — the same in every mode ───────────────────────────
# The bar and window borders use a neutral slate that sits between the dark and
# light palettes rather than following either. Two reasons:
#
#   1. Speed. i3 reads colours only at config-parse time, so changing them needs
#      `i3-msg restart` — which tears down and rebuilds the WM, flashing the root
#      window. Keeping these identical across modes means colours.conf never
#      changes, so the restart never happens and a mode switch is instant.
#
#   2. It looks fine either way. A dark bar above light apps is a normal desktop
#      convention; it is only a problem if it is *black* next to a white app.
#
# Change these if you want, but change them in BOTH theme files or you reinstate
# the restart.
ui_bg=#23232b
ui_fg=#e8e8ee
ui_accent=#78a9ff
ui_dim=#8a8a96
ui_urgent=#ee5396
ui_panel=#2f2f38
