# carbonfox — the dark palette. THE definition; everything else is rendered
# from it, so this is the only place these hex values appear.
#
# Consumed by i3/scripts/ui-mode, which renders templates/*.template with these
# values. Adding a theme means adding a file like this one — no template or
# script changes.
#
# name= must match a nightfox colorscheme, since nvim loads it by name rather
# than being handed colours.
name=carbonfox

# Desktop background. Leave wallpaper unset to use a plain fill of bg, which is
# what a tiling WM mostly shows anyway — you rarely see the root window. Point it
# at an image file to use one instead; ~ is expanded.
#wallpaper=

# UI roles — used by the i3 template.
bg=#161616
fg=#f2f4f8
accent=#78a9ff
dim=#6b6b6b
urgent=#ee5396
panel=#2a2a2a
sel=#2a2a2a
url=#33b1ff

# ANSI 0-15 — used by the terminal template.
color0=#161616
color1=#ee5396
color2=#25be6a
color3=#08bdba
color4=#78a9ff
color5=#be95ff
color6=#33b1ff
color7=#dfdfe0
color8=#6b6b6b
color9=#f16da6
color10=#46c880
color11=#2dc7c4
color12=#8cb6ff
color13=#c8a5ff
color14=#52bdff
color15=#f2f4f8
