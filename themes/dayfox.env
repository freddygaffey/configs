# dayfox — the light palette, for glare (fly mode). Values taken from the
# installed nightfox plugin's dayfox palette, so the terminal, i3 and nvim match
# exactly rather than approximately.
#
# dayfox rather than dawnfox: dawnfox is the pale rose-pine-derived one, washed
# out and low-contrast in bright light, which is the opposite of what a glare
# mode needs.
name=dayfox

# Terminal background opacity. Lower in light mode so the wallpaper shows
# through — a light terminal is a large bright rectangle, and letting the image
# come through takes the glare off as well as looking better.
term_opacity=0.82

# Desktop background. Leave wallpaper unset to use a plain fill of bg, which is
# what a tiling WM mostly shows anyway — you rarely see the root window. Point it
# at an image file to use one instead; ~ is expanded.
#wallpaper=

bg=#f6f2ee

# Terminal-only overrides, so the terminal can be softer than the rest of the
# desktop. dayfox's own background (#f6f2ee) is nearly white — right behind apps,
# but a large bright rectangle to work in. #e8e2d9 is a shade warmer and dimmer
# without reading as grey. Combined with term_opacity the wallpaper shows through
# as well, which softens it further.
#
# Dimmer options if this is still too bright: #ded8cf, then #d6cfc4 — about as
# dark as still reads as light mode. term_fg is left following fg (a warm
# near-black at 15:1 contrast), which is the part that was working.
term_bg=#e8e2d9
#term_fg=#1c1a17
# Not dayfox's own fg (#3d2b5a): that is a muted purple which reads as grey
# against the warm background. A warm near-black gives ~15:1 contrast, which
# is what a glare mode actually needs.
fg=#1c1a17
accent=#2848a9
dim=#837a72
urgent=#a5222f
panel=#e4dcd4
sel=#e7d2be
url=#287980

color0=#1c1a17
color1=#a5222f
color2=#396847
color3=#ac5402
color4=#2848a9
color5=#6e33ce
color6=#287980
color7=#f2e9e1
color8=#5a4f45
color9=#c0394a
color10=#4c8159
color11=#c76a12
color12=#3a5cc4
color13=#8450e0
color14=#349aa2
color15=#f6f2ee
