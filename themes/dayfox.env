# dayfox — the light palette, for glare (fly mode). Values taken from the
# installed nightfox plugin's dayfox palette, so the terminal, i3 and nvim match
# exactly rather than approximately.
#
# dayfox rather than dawnfox: dawnfox is the pale rose-pine-derived one, washed
# out and low-contrast in bright light, which is the opposite of what a glare
# mode needs.
name=dayfox

# Claude Code's theme. It runs IN the terminal, so it follows the TERMINAL's
# palette, not the desktop's — which is why this is set per palette rather than
# per mode, and why "auto" is wrong here: auto follows the system colour scheme,
# and in light mode that is light while this terminal is dark.
# Claude Code takes a named theme, not hex: dark | light (or their -daltonized
# and -ansi variants).
claude_theme=light

# Terminal background opacity, so the wallpaper shows through.
#
# This is the ONLY place transparency is applied. picom's inactive-opacity is
# deliberately 1.0: it used to be 0.92, which multiplied with this value, so an
# unfocused terminal sat at 0.86 x 0.92 = 0.79 and lost contrast twice. That
# compounding — not this number — is what made text hard to read. Focus is shown
# by inactive-dim instead, which darkens without letting the image through.
term_opacity=0.82

# Desktop background. Leave wallpaper unset to use a plain fill of bg, which is
# what a tiling WM mostly shows anyway — you rarely see the root window. Point it
# at an image file to use one instead; ~ is expanded.
#wallpaper=

bg=#f6f2ee

# Terminal-only overrides, so the terminal can be softer than the rest of the
# desktop. dayfox's own background (#f6f2ee) is nearly white — right behind apps,
# but a large bright rectangle to work in. #e8e2d9 is a shade warmer and dimmer
# without reading as grey. Combined with term_opacity the wallpaper shows through
# as well, which softens it further.
#
# Dimmer options if this is still too bright: #ded8cf, then #d6cfc4 — about as
# dark as still reads as light mode. term_fg is left following fg (a warm
# near-black at 15:1 contrast), which is the part that was working.
term_bg=#e8e2d9
#term_fg=#1c1a17
# Not dayfox's own fg (#3d2b5a): that is a muted purple which reads as grey
# against the warm background. A warm near-black gives ~15:1 contrast, which
# is what a glare mode actually needs.
fg=#1c1a17
accent=#2848a9
dim=#837a72
urgent=#a5222f
panel=#e4dcd4
sel=#e7d2be
url=#287980

color0=#1c1a17
color1=#a5222f
color2=#396847
color3=#ac5402
color4=#2848a9
color5=#6e33ce
color6=#287980
color7=#f2e9e1
color8=#5a4f45
color9=#c0394a
color10=#4c8159
color11=#c76a12
color12=#3a5cc4
color13=#8450e0
color14=#349aa2
color15=#f6f2ee

# ── i3's own chrome — the same in every mode ───────────────────────────
# The bar and window borders use a neutral slate that sits between the dark and
# light palettes rather than following either. Two reasons:
#
#   1. Speed. i3 reads colours only at config-parse time, so changing them needs
#      `i3-msg restart` — which tears down and rebuilds the WM, flashing the root
#      window. Keeping these identical across modes means colours.conf never
#      changes, so the restart never happens and a mode switch is instant.
#
#   2. It looks fine either way. A dark bar above light apps is a normal desktop
#      convention; it is only a problem if it is *black* next to a white app.
#
# Change these if you want, but change them in BOTH theme files or you reinstate
# the restart.
ui_bg=#23232b
ui_fg=#e8e8ee
ui_accent=#78a9ff
ui_dim=#8a8a96
ui_urgent=#ee5396
ui_panel=#2f2f38

# rofi's own base — darker than the bar, because a launcher sits ON TOP of the
# wallpaper rather than against a screen edge, so it needs to read as a panel
# rather than a tint over a photograph.
ui_menu_bg=#15151a
