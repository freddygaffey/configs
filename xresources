! Xresources — X11 font rendering and scaling. Symlinked to ~/.Xresources and
! merged by i3 on login (exec_always xrdb -merge).
!
! Xft.dpi is how X11 apps get scaled. GNOME did this with
! text-scaling-factor, which i3 does not read.
!
! 120 rather than the default 96 is 1.25x — 110 was still too small to read
! comfortably on this 2560x1600 16-inch panel. Stay short of 144, which triggers
! blurry half-scaling in some apps. Only affects apps started afterwards, so
! reload i3 and reopen them.
Xft.dpi:        120
Xft.antialias:  true
Xft.hinting:    true
Xft.rgba:       rgb
Xft.hintstyle:  hintslight
